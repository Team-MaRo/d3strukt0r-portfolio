{
  "name": "@d3strukt0r/portfolio",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "build:cf": "CLOUDFLARE=true nr build",
    "dev": "react-router dev",
    "dev:cf": "CLOUDFLARE=true nr dev",
    "deploy:cf": "nr build:cf && wrangler deploy",
    "cf-typegen": "wrangler types",
    "start": "react-router-serve ./build/client",
    "start:server": "react-router-serve ./build/server/index.js",
    "preview": "vite preview --outDir build/client",
    "typecheck": "nr cf-typegen && react-router typegen && tsc --noEmit && tsc --noEmit -p tsconfig.cloudflare.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "sync:linkedin:csv": "tsx bin/linkedin/from-csv.ts",
    "sync:linkedin:api": "node --env-file=.env --import tsx bin/linkedin/from-api.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "gsap": "^3.15.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.2.2",
    "marked-footnote": "^1.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router": "^8.3.1",
    "robotstxt-util": "^4.1.0",
    "sitemap": "^9.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@antfu/ni": "^30.5.0",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@iwf-web/eslint-coding-standard": "^1.1.1",
    "@iwf-web/tsconfig": "^1.1.1",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "csv-parse": "^7.0.2",
    "culori": "^4.0.2",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^5.4.1",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "marked": "^18.0.11",
    "png-to-ico": "^3.0.2",
    "sass": "^1.104.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
